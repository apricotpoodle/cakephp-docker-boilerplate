# Configuration locale du boilerplate CakePHP Docker.
# Copier ce fichier vers .env puis remplacer toutes les valeurs CHANGE_ME_*.
# Ne jamais commiter le fichier .env créé.

# Réseau et service Docker
PROJECT_NETWORK=mon_projet_dev
PROJECT_SUBNET=10.210.1.0/24
PHP_SERVICE_NAME=gdaetf

# Ports publiés sur l'hôte
FORWARD_APACHE_PORT=8080
FORWARD_APACHE_PORT_HTTPS=8443

# Application
APP_NAME=Mon application CakePHP
# Nom lisible de l'instance et destinataire des alertes techniques TreeBehavior.
APP_INSTANCE_NAME=mon-serveur-gdaetf2
TREE_INTEGRITY_ALERT_RECIPIENT=infogestion@lemonde.fr

# MySQL de développement : remplacer hôte, base et identifiants.
DB_CONNECTION=mysql
DB_HOST=CHANGE_ME_MYSQL_HOST
DB_PORT=3306
DB_DATABASE=CHANGE_ME_DEVELOPMENT_DATABASE
DB_USERNAME=CHANGE_ME_DEVELOPMENT_USERNAME
DB_PASSWORD=CHANGE_ME_DEVELOPMENT_PASSWORD
DATABASE_URL="mysql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_DATABASE}?encoding=utf8&timezone=UTC&cacheMetadata=true&quoteIdentifiers=false&persistent=false"

# MySQL de test : base dédiée, jamais développement, recette ou production.
# La cible Make actuelle vérifie explicitement le nom daetf2_test.
DATABASE_TEST_URL="mysql://CHANGE_ME_TEST_USERNAME:CHANGE_ME_TEST_PASSWORD@${DB_HOST}:${DB_PORT}/daetf2_test?encoding=utf8&timezone=UTC&cacheMetadata=true&quoteIdentifiers=false&persistent=false"

# Mailpit local (interface : http://localhost:8025).
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=no-reply@example.test
MAIL_FROM_NAME="${APP_NAME}"

# Secrets CakePHP : générer une valeur unique par environnement.
# Exemple : openssl rand -hex 32
SECURITY_SALT=CHANGE_ME_GENERATE_A_RANDOM_64_HEX_CHARACTER_SALT
# Exemple : openssl rand -hex 16
SECURITY_CIPHERSEED=CHANGE_ME_GENERATE_A_RANDOM_CIPHER_SEED
